# ===== Build-time env vars =====
# These are consumed by webpack.config.js and inlined into the JS bundle via
# DefinePlugin. They are NOT runtime env vars — changing them requires a
# rebuild + redeploy. Set them on Vercel under Project Settings → Environment
# Variables (or in a local .env if you wire one up; webpack does not read
# .env files automatically — pass via shell or cross-env).

# Backend API base URL. Leave empty (or unset) to fall back to '/api' so a
# same-origin reverse proxy can route the requests. Once the Spring Boot
# backend is hosted, set this to the absolute URL, e.g.
#   API_BASE_URL=https://skku-nav-api.example.com/api
API_BASE_URL=

# 360° video base URL. In dev, the frontend uses /videos from webpack-dev-server.
# In prod, leave this empty to use `${API_BASE_URL}/videos`, matching the current
# Spring endpoint GET /api/videos/{filename}. Set it only if videos move to a
# separate CDN/bucket later.
VIDEO_BASE_URL=

# Marker that switches the build to "production-only" mode: editor and debug
# UI are gated by `IS_PROD_BUILD` and stripped via terser dead-code
# elimination. Set automatically by `npm run build:prod` (do not set this
# manually unless you know what you're doing).
# PROD_BUILD=true
